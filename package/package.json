{
  "name": "@clawpump/agents",
  "version": "0.1.25",
  "description": "MCP server for ClawPump agent management — create agents, chat, manage skills/automations/marketplace/billing from any MCP client",
  "license": "MIT",
  "type": "module",
  "bin": {
    "clawpump-agents": "./bin/clawpump-agents.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev:http": "tsup && node dist/http-server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test --test-isolation=none --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "clawpump",
    "ai-agents",
    "solana",
    "defi",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Clawpump/mcp-agents.git"
  },
  "homepage": "https://agents.clawpump.tech",
  "author": "ClawPump (https://agents.clawpump.tech)",
  "bugs": {
    "url": "https://github.com/Clawpump/mcp-agents/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  }
}
