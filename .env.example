# ===========================================
# BullClaw Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ===========================================
# DATABASE (Required)
# ===========================================
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host.database.neon.tech/bullclaw?sslmode=require"

# ===========================================
# UPSTASH REDIS (Required)
# ===========================================
# Upstash Redis for session management and rate limiting
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# ===========================================
# CLAWPUMP (Required for agent creation)
# ===========================================
# Get your API key from https://clawpump.tech/dashboard
CLAWPUMP_API_KEY="cpk_your_clawpump_api_key"

# ===========================================
# HELIUS (Required for trading)
# ===========================================
# Get your API key from https://helius.xyz/dashboard
HELIUS_API_KEY="your_helius_api_key"
HELIUS_RPC_URL="https://mainnet.helius-rpc.com/?api-key=your_helius_api_key"

# ===========================================
# ENCRYPTION (Required)
# ===========================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your_32_byte_hex_encryption_key"

# ===========================================
# TELEGRAM (Optional)
# ===========================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# ===========================================
# SOLANA CONSTANTS
# ===========================================
ANSEM_MINT="9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump"
ANSEM_WALLET="GV6UUmNxz2RpKxmNAPadYKb7uQpszwqQAu3qLJxVdC52"
CLAW_MINT="739dnZEG4yaBWFsY8L8ZwrfhGG6dhtCSercW8Umspump"

# ===========================================
# APPLICATION URL
# ===========================================
# Your deployment URL (used for skill.md links)
NEXT_PUBLIC_BASE_URL="https://bullclaw.vercel.app"

# ===========================================
# SOLANA RPC (Optional - uses Helius if not set)
# ===========================================
NEXT_PUBLIC_RPC_URL="https://mainnet.helius-rpc.com/?api-key=your_helius_api_key"
NEXT_PUBLIC_ANSEM_MINT="9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump"

# ===========================================
# JUPITER API (Optional)
# ===========================================
JUPITER_API_KEY="your_jupiter_api_key"

# ===========================================
# DEVELOPMENT ONLY
# ===========================================
# Set to "true" to enable demo mode without database
DEMO_MODE="false"

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV="development"
